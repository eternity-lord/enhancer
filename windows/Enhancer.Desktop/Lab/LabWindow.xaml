<Window x:Class="Enhancer.Desktop.Lab.LabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Enhancer.Desktop.Localization"
        Title="Enhancer Lab — Offline Retouch &amp; Color"
        Width="1500"
        Height="940"
        MinWidth="1160"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#090D16"
        Foreground="#F8FAFC"
        FlowDirection="{Binding Source={x:Static loc:Strings.Instance}, Path=WindowFlow}"
        Loaded="LabWindow_Loaded"
        KeyDown="LabWindow_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1322" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#312E81" Margin="0,0,12,0">
                        <TextBlock Text="LAB" FontSize="12" FontWeight="Bold" Foreground="#C7D2FE" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Enhancer Lab" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Offline portrait retouch, color grading &amp; Photoshop-style presets" FontSize="11.5" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtImageName" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No image" FontSize="12.5" Foreground="#A5B4FC" TextTrimming="CharacterEllipsis" Margin="20,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Image" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,7,0" Click="BtnOpenImage_Click" />
                    <Button Content="Import Preset" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,7,0" Click="BtnImportPreset_Click" />
                    <Button Content="Export Preset" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,7,0" Click="BtnExportPreset_Click" />
                    <Button Content="Undo" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,7,0" Click="BtnUndo_Click" />
                    <Button Content="Redo" Style="{StaticResource SecondaryStudioButton}" Click="BtnRedo_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" MinWidth="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" MinWidth="310" />
            </Grid.ColumnDefinitions>

            <!-- Presets and professional workflow actions -->
            <Border Grid.Column="0" Background="#0E1525" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PRESETS / پریست‌ها" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8" />
                        <ComboBox x:Name="CmbPreset" SelectionChanged="CmbPreset_SelectionChanged" Margin="0,0,0,12" />
                        <TextBlock Text="Modern portrait looks, cinematic grades, studio cleanup and fine-art monochrome. Presets are non-destructive." TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,16" />

                        <Border Background="#141E30" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PORTRAIT RETOUCH" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkMonochrome" Content="Black &amp; White / سیاه‌وسفید" Checked="CheckChanged" Unchecked="CheckChanged" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkFaceProtection" Content="Protect painted face mask" IsChecked="True" Checked="CheckChanged" Unchecked="CheckChanged" Margin="0,0,0,7" />
                                <TextBlock Text="Paint over eyes, skin or other identity-critical areas to protect them from local retouch. The mask is saved with JSON/XMP presets." TextWrapping="Wrap" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,8" />
                                <TextBlock Text="LOCAL RETOUCH MASK / ماسک روتوش موضعی" FontSize="10.5" FontWeight="Bold" Foreground="#FDBA74" Margin="0,2,0,5" />
                                <TextBlock Text="Retouch strength / شدت روتوش" FontSize="10" Foreground="#CBD5E1" />
                                <Slider x:Name="SldManualRetouchStrength" Minimum="0" Maximum="1" Value="0.75" ValueChanged="SliderChanged" />
                                <TextBlock x:Name="TxtManualRetouchStrength" Text="+75%" Style="{StaticResource LabValue}" Margin="0,0,0,5" />
                                <Button Content="Strong Local Retouch" Style="{StaticResource SecondaryStudioButton}" Padding="8,5" Margin="0,0,0,7" Click="BtnStrongManualRetouch_Click" />
                                <TextBlock Text="Mask brush size / اندازه قلم" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                <Slider x:Name="SldMaskBrush" Minimum="0.01" Maximum="0.28" Value="0.08" ToolTip="Mask brush size" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,4">
                                    <Button x:Name="BtnPaintRetouch" Content="Paint Retouch Area" Style="{StaticResource SecondaryStudioButton}" Padding="7,5" Margin="0,0,5,0" Click="BtnPaintRetouch_Click" />
                                    <Button x:Name="BtnEraseRetouch" Content="Erase Retouch Area" Style="{StaticResource SecondaryStudioButton}" Padding="7,5" Click="BtnEraseRetouch_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnPaintMask" Content="Paint Protect Mask" Style="{StaticResource SecondaryStudioButton}" Padding="7,5" Margin="0,0,5,0" Click="BtnPaintMask_Click" />
                                    <Button x:Name="BtnEraseMask" Content="Erase Protect Mask" Style="{StaticResource SecondaryStudioButton}" Padding="7,5" Margin="0,0,5,0" Click="BtnEraseMask_Click" />
                                    <Button Content="Clear" Style="{StaticResource SecondaryStudioButton}" Padding="7,5" Click="BtnClearMask_Click" />
                                </StackPanel>
                                <TextBlock Text="Orange = selected area for stronger manual retouch. Green = protect identity-critical areas. Red = erase mask." TextWrapping="Wrap" FontSize="10" Foreground="#64748B" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WORKFLOW" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8" />
                        <Button Content="AI Portrait Restore (4×)" Style="{StaticResource PrimaryStudioButton}" Margin="0,0,0,7" Click="BtnAiPortrait_Click" />
                        <Button Content="Batch Apply Current Look" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,0,7" Click="BtnBatchApply_Click" />
                        <Button Content="Preview Original (P)" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,0,7" Click="BtnTogglePreview_Click" />
                        <Button Content="Reset Adjustments" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,0,7" Click="BtnReset_Click" />
                        <Button Content="Copy Current Look" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,0,14" Click="BtnCopyLook_Click" />

                        <Border Background="#111827" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="PRO WORKFLOW" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,7" />
                                <TextBlock Text="• Non-destructive original + live preview&#x0a;• Undo / redo history&#x0a;• Strong local retouch with painted area mask&#x0a;• Painted protection masks for identity safety&#x0a;• RGB curves and shadow/highlight wheels&#x0a;• Adobe Camera Raw XMP import&#x0a;• Batch apply beside originals&#x0a;• Portable .enhancerpreset JSON export&#x0a;• High-quality PNG / JPEG export" TextWrapping="Wrap" FontSize="10.5" Foreground="#CBD5E1" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main preview -->
            <Grid Grid.Column="1" Background="#070A12" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#0C1220" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="13,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Fit" Style="{StaticResource SecondaryStudioButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnFit_Click" />
                            <Button Content="100%" Style="{StaticResource SecondaryStudioButton}" Padding="10,4" Margin="0,0,6,0" Click="Btn100_Click" />
                            <Button Content="200%" Style="{StaticResource SecondaryStudioButton}" Padding="10,4" Click="Btn200_Click" />
                        </StackPanel>
                        <TextBlock x:Name="TxtPreviewMode" Text="EDITED PREVIEW" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#A5B4FC" />
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Margin="18" Background="#0B1020" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#070A12">
                        <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ImgPreview" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas x:Name="MaskCanvas" Background="Transparent" IsHitTestVisible="False" Opacity="0" Panel.ZIndex="5"
                                    MouseLeftButtonDown="MaskCanvas_MouseLeftButtonDown"
                                    MouseMove="MaskCanvas_MouseMove"
                                    MouseLeftButtonUp="MaskCanvas_MouseLeftButtonUp" />
                        </Grid>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="2" Background="#0C1220" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="13,0">
                    <TextBlock x:Name="TxtHistogram" VerticalAlignment="Center" Text="Histogram — load an image" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <!-- Adjustment inspector -->
            <Border Grid.Column="2" Background="#0E1525" BorderBrush="#1E293B" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="TONE / تون" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8" />
                        <TextBlock Text="Exposure / نوردهی" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldExposure" Minimum="-3" Maximum="3" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtExposure" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Contrast / کنتراست" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldContrast" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtContrast" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Highlights / روشنایی‌ها" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldHighlights" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtHighlights" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Shadows / سایه‌ها" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldShadows" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtShadows" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Black Point / نقطه سیاه" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldBlackPoint" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtBlackPoint" Style="{StaticResource LabValue}" />
                        <TextBlock Text="White Point / نقطه سفید" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldWhitePoint" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtWhitePoint" Style="{StaticResource LabValue}" />

                        <TextBlock Text="COLOR / رنگ" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,13,0,8" />
                        <TextBlock Text="Temperature / دمای رنگ" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldTemperature" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtTemperature" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Tint / ته‌رنگ" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldTint" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtTint" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Saturation / اشباع" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldSaturation" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtSaturation" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Vibrance / شادابی" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldVibrance" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtVibrance" Style="{StaticResource LabValue}" />

                        <TextBlock Text="CURVES / منحنی‌ها" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,13,0,8" />
                        <TextBlock Text="Black point curve / منحنی سایه عمیق" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldCurveBlack" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtCurveBlack" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Quarter-tone curve / یک‌چهارم" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldCurveQuarter" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtCurveQuarter" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Mid-tone curve / میانه" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldCurveMid" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtCurveMid" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Three-quarter curve / سه‌چهارم" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldCurveThreeQuarter" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtCurveThreeQuarter" Style="{StaticResource LabValue}" />
                        <TextBlock Text="White point curve / منحنی روشنایی" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldCurveWhite" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtCurveWhite" Style="{StaticResource LabValue}" />

                        <TextBlock Text="COLOR WHEELS / چرخ رنگ" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,13,0,8" />
                        <TextBlock Text="Shadow hue / رنگ سایه‌ها" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldShadowHue" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtShadowHue" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Shadow saturation / اشباع سایه‌ها" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldShadowSaturation" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtShadowSaturation" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Highlight hue / رنگ روشنایی‌ها" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldHighlightHue" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtHighlightHue" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Highlight saturation / اشباع روشنایی‌ها" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldHighlightSaturation" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtHighlightSaturation" Style="{StaticResource LabValue}" />

                        <TextBlock Text="PORTRAIT &amp; DETAIL / پرتره و جزئیات" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,13,0,8" />
                        <TextBlock Text="Move a slider to render the offline preview. Large photos or CPU fallback can take a few seconds; the status bar shows progress." TextWrapping="Wrap" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,7" />
                        <TextBlock Text="Clarity / وضوح موضعی" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldClarity" Minimum="-1" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtClarity" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Skin Smoothing / صاف‌کردن پوست" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldSkinSmoothing" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtSkinSmoothing" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Face Light / نور چهره" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldFaceLight" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtFaceLight" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Eye Detail / جزئیات چشم" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldEyeDetail" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtEyeDetail" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Teeth Whiten / سفیدکردن دندان" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldTeethWhiten" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtTeethWhiten" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Sharpening / شارپنس" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldSharpening" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtSharpening" Style="{StaticResource LabValue}" />

                        <TextBlock Text="FINISH / پرداخت نهایی" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,13,0,8" />
                        <TextBlock Text="Vignette / وینیت" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldVignette" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtVignette" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Grain / دانه فیلم" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldGrain" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtGrain" Style="{StaticResource LabValue}" />
                        <TextBlock Text="Fade / مات‌کردن" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldFade" Minimum="0" Maximum="1" Value="0" ValueChanged="SliderChanged" />
                        <TextBlock x:Name="TxtFade" Style="{StaticResource LabValue}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0D1322" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="100% offline • original remains untouched • presets can be shared with Photoshop XMP workflows" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save JPEG" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,8,0" Click="BtnSaveJpeg_Click" />
                    <Button Content="Save PNG" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,8,0" Click="BtnSavePng_Click" />
                    <Button Content="Done" Style="{StaticResource PrimaryStudioButton}" Padding="22,9" Click="BtnDone_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
