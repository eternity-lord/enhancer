<Window x:Class="Enhancer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Enhancer.Desktop.Localization"
        Title="Enhancer v3.0 Studio — Windows x64"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#090D16"
        Foreground="#F8FAFC"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        FlowDirection="{Binding Source={x:Static loc:Strings.Instance}, Path=WindowFlow}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP STUDIO HEADER BAR ==================== -->
        <Border Grid.Row="0"
                Background="#0D1322"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0" />
                                <GradientStop Color="#7C3AED" Offset="0.6" />
                                <GradientStop Color="#06B6D4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M12,2 L14.6,9.4 L22,12 L14.6,14.6 L12,22 L9.4,14.6 L2,12 L9.4,9.4 Z"
                              Fill="White"
                              Stretch="Uniform"
                              Margin="8" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=AppTitle}"
                                       FontSize="16.5"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC" />
                            <Border Background="#1E1B4B"
                                    BorderBrush="#4F46E5"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=CreditBadge}"
                                           FontSize="11"
                                           Foreground="#A5B4FC"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=AppSubtitle}"
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Center Hardware Status Pill -->
                <Border x:Name="HardwarePillBorder"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#0F2922"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="13,5"
                        Margin="12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HardwareDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#10B981"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtHardwareBadge"
                                   Text="Detecting Hardware..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#D1FAE5" />
                    </StackPanel>
                </Border>

                <!-- Right Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=DiagnosticsBtn}"
                            Style="{StaticResource SecondaryStudioButton}"
                            Margin="0,0,8,0"
                            Click="BtnDiagnostics_Click" />
                    <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=LangButtonLabel}"
                            Style="{StaticResource SecondaryStudioButton}"
                            FontWeight="SemiBold"
                            Click="BtnToggleLanguage_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN 3-COLUMN STUDIO WORKSPACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="295" MinWidth="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- ========== COLUMN 0: BATCH QUEUE & OUTPUT FOLDER ========== -->
            <Border Grid.Column="0"
                    Background="#0E1525"
                    BorderBrush="#1E293B"
                    BorderThickness="0,0,1,0"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=QueueHeader}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtQueueCount"
                                   Text="0"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#818CF8" />
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=AddImagesBtn}"
                                Style="{StaticResource PrimaryStudioButton}"
                                Padding="11,6"
                                FontSize="12"
                                Margin="0,0,6,6"
                                Click="BtnAddImages_Click" />
                        <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=AddFolderBtn}"
                                Style="{StaticResource SecondaryStudioButton}"
                                Padding="10,6"
                                FontSize="12"
                                Margin="0,0,6,6"
                                Click="BtnAddFolder_Click" />
                        <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=DemoImageBtn}"
                                Style="{StaticResource SecondaryStudioButton}"
                                Padding="10,6"
                                FontSize="12"
                                Margin="0,0,0,6"
                                Click="BtnLoadSample_Click" />
                    </WrapPanel>

                    <!-- Queue ListBox -->
                    <Border Grid.Row="2"
                            Background="#090D16"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ListBox x:Name="LstQueue"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F8FAFC"
                                 SelectionChanged="LstQueue_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,7" />
                                    <Setter Property="Margin" Value="4,3" />
                                    <Setter Property="Background" Value="#131C2E" />
                                    <Setter Property="BorderBrush" Value="#1E293B" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#1E1B4B" />
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#6366F1" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#4F46E5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="#F8FAFC"
                                                   TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock Text="{Binding DimensionsBadge}"
                                                       FontSize="11"
                                                       Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       DockPanel.Dock="Right"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#818CF8" />
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,12">
                        <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ClearQueueBtn}"
                                Style="{StaticResource SecondaryStudioButton}"
                                FontSize="11.5"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Click="BtnClearQueue_Click" />
                        <Button x:Name="BtnOpenOutputExplorer"
                                Content="{Binding Source={x:Static loc:Strings.Instance}, Path=OpenOutputBtn}"
                                Style="{StaticResource SecondaryStudioButton}"
                                FontSize="11.5"
                                Padding="10,5"
                                Click="BtnOpenOutputExplorer_Click" />
                    </StackPanel>

                    <!-- Output Destination Card -->
                    <Border Grid.Row="4"
                            Background="#141E30"
                            BorderBrush="#263449"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=OutputDirHeader}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8" />
                            <TextBlock x:Name="TxtOutputFolderDisplay"
                                       Text="{Binding Source={x:Static loc:Strings.Instance}, Path=SameAsInputLabel}"
                                       FontSize="11.5"
                                       Foreground="#E2E8F0"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ChooseFolderBtn}"
                                        Style="{StaticResource SecondaryStudioButton}"
                                        FontSize="11.5"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        Click="BtnChooseOutputFolder_Click" />
                                <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ResetFolderBtn}"
                                        Style="{StaticResource SecondaryStudioButton}"
                                        FontSize="11.5"
                                        Padding="10,4"
                                        Click="BtnResetOutputFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========== COLUMN 1: INTERACTIVE PAN/ZOOM BEFORE/AFTER CANVAS ========== -->
            <Grid Grid.Column="1" Background="#070A12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <!-- Top Canvas Toolbar (Zoom + Split Slider) -->
                <Border Grid.Row="0"
                        Background="#0C1220"
                        BorderBrush="#1E293B"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=FitBtn}"
                                    Style="{StaticResource SecondaryStudioButton}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Margin="0,0,5,0"
                                    Click="BtnZoomFit_Click" />
                            <Button Content="100%"
                                    Style="{StaticResource SecondaryStudioButton}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Margin="0,0,5,0"
                                    Click="BtnZoom100_Click" />
                            <Button Content="200%"
                                    Style="{StaticResource SecondaryStudioButton}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Margin="0,0,5,0"
                                    Click="BtnZoom200_Click" />
                            <Button Content="400%"
                                    Style="{StaticResource SecondaryStudioButton}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Margin="0,0,10,0"
                                    Click="BtnZoom400_Click" />
                            <TextBlock x:Name="TxtZoomReadout"
                                       Text="Fit"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#A5B4FC" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=SplitSliderLabel}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       Margin="0,0,8,0" />
                            <Slider x:Name="SldSplit"
                                    Width="170"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="50"
                                    VerticalAlignment="Center"
                                    ValueChanged="SldSplit_ValueChanged" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Center Viewport (Explicit LTR so Persian RTL UI never mirrors photographs!) -->
                <Grid x:Name="ViewportHost"
                      Grid.Row="1"
                      FlowDirection="LeftToRight"
                      ClipToBounds="True"
                      Background="#070A12"
                      MouseWheel="ViewportHost_MouseWheel"
                      MouseDown="ViewportHost_MouseDown"
                      MouseMove="ViewportHost_MouseMove"
                      MouseUp="ViewportHost_MouseUp"
                      SizeChanged="ViewportHost_SizeChanged">

                    <!-- Empty Drop State -->
                    <Border x:Name="EmptyDropOverlay"
                            Width="500"
                            Height="250"
                            Background="#0E1525"
                            BorderBrush="#334155"
                            BorderThickness="1.5"
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="✦"
                                       FontSize="34"
                                       Foreground="#818CF8"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=DropTitle}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=DropSubtitle}"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,16" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=AddImagesBtn}"
                                        Style="{StaticResource PrimaryStudioButton}"
                                        Margin="0,0,8,0"
                                        Click="BtnAddImages_Click" />
                                <Button Content="{Binding Source={x:Static loc:Strings.Instance}, Path=DemoImageBtn}"
                                        Style="{StaticResource SecondaryStudioButton}"
                                        Click="BtnLoadSample_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Interactive Zoom/Pan Split Stage -->
                    <Canvas x:Name="PanZoomCanvas" Visibility="Collapsed">
                        <Grid x:Name="CompareStage"
                              RenderTransformOrigin="0,0"
                              Cursor="SizeWE">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="StageTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Bottom Layer: AFTER (Enhanced) or Source before enhancement -->
                            <Image x:Name="ImgAfter"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Top Layer: BEFORE (Original), clipped to [0 .. splitX] -->
                            <Image x:Name="ImgBefore"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

                            <!-- Split Wipe Vertical Line & Handle -->
                            <Canvas x:Name="SplitOverlayCanvas" IsHitTestVisible="False">
                                <Line x:Name="SplitLine"
                                      Stroke="#F8FAFC"
                                      StrokeThickness="2" />
                                <Border x:Name="SplitHandleKnob"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="17"
                                        Background="#4F46E5"
                                        BorderBrush="White"
                                        BorderThickness="2">
                                    <TextBlock Text="◄►"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Canvas>
                        </Grid>
                    </Canvas>

                    <!-- Floating BEFORE / AFTER Corner Pills -->
                    <Border x:Name="BadgeBefore"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="14"
                            Background="#CC0F172A"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9,4"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=BeforeBadge}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#E2E8F0" />
                    </Border>

                    <Border x:Name="BadgeAfter"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="14"
                            Background="#CC1E1B4B"
                            BorderBrush="#6366F1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9,4"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="TxtAfterBadgeLabel"
                                   Text="{Binding Source={x:Static loc:Strings.Instance}, Path=AfterBadge}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#C7D2FE" />
                    </Border>
                </Grid>

                <!-- Live Dimension & Print Pipeline Strip -->
                <Border Grid.Row="2"
                        Background="#0C1220"
                        BorderBrush="#1E293B"
                        BorderThickness="0,1,0,0"
                        Padding="14,0">
                    <TextBlock x:Name="TxtDimensionPlan"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#94A3B8"
                               TextTrimming="CharacterEllipsis"
                               Text="Load or drop an image to preview exact AI Super-Resolution &amp; 300 DPI print dimensions." />
                </Border>
            </Grid>

            <!-- ========== COLUMN 2: RIGHT STUDIO INSPECTOR (ALL CONTROLS UNLOCKED) ========== -->
            <Border Grid.Column="2"
                    Background="#0E1525"
                    BorderBrush="#1E293B"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15,14">
                    <StackPanel>

                        <!-- SECTION 1: 7 AI STUDIO MODES -->
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=ModesSectionTitle}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#818CF8"
                                   Margin="0,0,0,8" />

                        <WrapPanel Margin="0,0,0,10">
                            <Button x:Name="BtnModePrime" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ModePrime}" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,6,6" Tag="0" Click="BtnModePreset_Click" />
                            <Button x:Name="BtnModeGentle" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ModeGentle}" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,6,6" Tag="1" Click="BtnModePreset_Click" />
                            <Button x:Name="BtnModeBalanced" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ModeBalanced}" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,6,6" Tag="2" Click="BtnModePreset_Click" />
                            <Button x:Name="BtnModeStrong" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ModeStrong}" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,6,6" Tag="3" Click="BtnModePreset_Click" />
                            <Button x:Name="BtnModeUltra" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ModeUltra}" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,6,6" Tag="4" Click="BtnModePreset_Click" />
                            <Button x:Name="BtnModeDigitalArt" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ModeDigitalArt}" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,6,6" Tag="5" Click="BtnModePreset_Click" />
                            <Button x:Name="BtnModeOldPhoto" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=ModeOldPhoto}" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,6,6" Tag="6" Click="BtnModePreset_Click" />
                        </WrapPanel>

                        <!-- Ultra Multi-Scale Sliders Card -->
                        <Border x:Name="CardUltraControls"
                                Background="#151E32"
                                BorderBrush="#312E81"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,9"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=UltraIntensityLabel}" FontSize="12" Foreground="#E2E8F0" />
                                    <TextBlock x:Name="TxtValUltraIntensity" Text="65%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                </DockPanel>
                                <Slider x:Name="SldUltraIntensity" Minimum="0" Maximum="100" Value="65" Margin="0,3,0,8" ValueChanged="AnySettingSlider_ValueChanged" />

                                <DockPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=UltraSizeLabel}" FontSize="12" Foreground="#E2E8F0" />
                                    <TextBlock x:Name="TxtValUltraSize" Text="45%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                </DockPanel>
                                <Slider x:Name="SldUltraSize" Minimum="0" Maximum="100" Value="45" Margin="0,3,0,0" ValueChanged="AnySettingSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: PORTRAIT FACES & SMART HDR -->
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=PortraitLightSection}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#818CF8"
                                   Margin="0,0,0,8" />

                        <Border Background="#141E30" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="11,10" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnhanceFaces"
                                          Content="{Binding Source={x:Static loc:Strings.Instance}, Path=EnhanceFacesCheck}"
                                          IsChecked="True"
                                          Margin="0,0,0,6"
                                          Checked="AnyCheck_Changed"
                                          Unchecked="AnyCheck_Changed" />
                                <DockPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=FaceStrengthLabel}" FontSize="12" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="TxtValFaceStrength" Text="70%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                </DockPanel>
                                <Slider x:Name="SldFaceStrength" Minimum="0" Maximum="100" Value="70" Margin="0,3,0,10" ValueChanged="AnySettingSlider_ValueChanged" />

                                <CheckBox x:Name="ChkLightAi"
                                          Content="{Binding Source={x:Static loc:Strings.Instance}, Path=LightAiCheck}"
                                          IsChecked="True"
                                          Margin="0,0,0,6"
                                          Checked="AnyCheck_Changed"
                                          Unchecked="AnyCheck_Changed" />
                                <DockPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=LightAiStrengthLabel}" FontSize="12" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="TxtValLightAi" Text="45%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                </DockPanel>
                                <Slider x:Name="SldLightAiStrength" Minimum="0" Maximum="100" Value="45" Margin="0,3,0,10" ValueChanged="AnySettingSlider_ValueChanged" />

                                <DockPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=DenoiseLabel}" FontSize="12" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="TxtValDenoise" Text="18%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                </DockPanel>
                                <Slider x:Name="SldDenoise" Minimum="0" Maximum="100" Value="18" Margin="0,3,0,10" ValueChanged="AnySettingSlider_ValueChanged" />

                                <DockPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=SharpnessLabel}" FontSize="12" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="TxtValSharpness" Text="12%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                </DockPanel>
                                <Slider x:Name="SldSharpness" Minimum="0" Maximum="100" Value="12" Margin="0,3,0,0" ValueChanged="AnySettingSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: NEURAL MODEL & TARGET RESOLUTION (UP TO 16K) -->
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=ModelResSection}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#818CF8"
                                   Margin="0,0,0,8" />

                        <Border Background="#141E30" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="11,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=NeuralModelLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbModel" Margin="0,0,0,10" SelectionChanged="CmbModel_SelectionChanged" />

                                <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=TargetResLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbTargetRes" Margin="0,0,0,8" SelectionChanged="CmbTargetRes_SelectionChanged" />

                                <DockPanel x:Name="PanelCustomLongSide" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=CustomPxLabel}" VerticalAlignment="Center" FontSize="12" Foreground="#CBD5E1" Margin="0,0,8,0" />
                                    <TextBox x:Name="TxtCustomLongSide" Text="4096" TextChanged="TxtCustomLongSide_TextChanged" />
                                </DockPanel>

                                <CheckBox x:Name="ChkMaxQuality"
                                          Content="{Binding Source={x:Static loc:Strings.Instance}, Path=MaxQualityCheck}"
                                          Margin="0,2,0,6"
                                          Checked="AnyCheck_Changed"
                                          Unchecked="AnyCheck_Changed" />
                                <CheckBox x:Name="ChkTtaX8"
                                          Content="{Binding Source={x:Static loc:Strings.Instance}, Path=TtaCheck}"
                                          Checked="AnyCheck_Changed"
                                          Unchecked="AnyCheck_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 4: PC HARDWARE (VULKAN GPU + NO-GPU MULTI-CORE CPU) -->
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=HardwareSection}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#818CF8"
                                   Margin="0,0,0,8" />

                        <Border Background="#141E30" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="11,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=ComputeDeviceLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbComputeDevice" Margin="0,0,0,10" SelectionChanged="AnyCombo_SelectionChanged" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=CpuThreadsLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CmbCpuThreads" SelectionChanged="AnyCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=TileSizeLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CmbTileSize" SelectionChanged="AnyCombo_SelectionChanged" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="ChkDisableFp16"
                                          Content="{Binding Source={x:Static loc:Strings.Instance}, Path=DisableFp16Check}"
                                          Checked="ChkDisableFp16_Changed"
                                          Unchecked="ChkDisableFp16_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 5: EXPORT FORMAT & 300 DPI PRINT METADATA -->
                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=ExportSection}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#818CF8"
                                   Margin="0,0,0,8" />

                        <Border Background="#141E30" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="11,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=FormatLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbOutputFormat" Margin="0,0,0,10" SelectionChanged="AnyCombo_SelectionChanged">
                                    <ComboBoxItem Content="JPEG (.jpg) — 4:4:4 Full Chroma (Zero Color Bleeding)" />
                                    <ComboBoxItem Content="PNG (.png) — 100% Lossless Archival" />
                                </ComboBox>

                                <DockPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=JpegQualityLabel}" FontSize="12" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="TxtValJpegQuality" Text="98%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                </DockPanel>
                                <Slider x:Name="SldJpegQuality" Minimum="90" Maximum="100" Value="98" Margin="0,3,0,10" ValueChanged="AnySettingSlider_ValueChanged" />

                                <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=PrintDpiLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbDpi" SelectionChanged="AnyCombo_SelectionChanged" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== BOTTOM ACTION & PROGRESS FOOTER ==================== -->
        <Border Grid.Row="2"
                Background="#0D1322"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Progress & Live Engine Telemetry -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="TxtStatusHeadline"
                                   Text="Studio Ready — Drop or add photos to enhance."
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC" />
                        <TextBlock x:Name="TxtTelemetryDetail"
                                   Text=""
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="#818CF8" />
                    </DockPanel>
                    <ProgressBar x:Name="PrgEnhance"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#1E293B"
                                 Foreground="#6366F1"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- Primary Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEnhanceSelected"
                            Content="{Binding Source={x:Static loc:Strings.Instance}, Path=EnhanceSelectedBtn}"
                            Style="{StaticResource PrimaryStudioButton}"
                            FontSize="13.5"
                            Padding="20,10"
                            Margin="0,0,10,0"
                            Click="BtnEnhanceSelected_Click" />
                    <Button x:Name="BtnEnhanceBatch"
                            Content="{Binding Source={x:Static loc:Strings.Instance}, Path=EnhanceBatchBtn}"
                            Style="{StaticResource SecondaryStudioButton}"
                            FontSize="13"
                            Padding="16,10"
                            Margin="0,0,10,0"
                            Click="BtnEnhanceBatch_Click" />
                    <Button x:Name="BtnCancelJob"
                            Content="{Binding Source={x:Static loc:Strings.Instance}, Path=CancelBtn}"
                            Style="{StaticResource SecondaryStudioButton}"
                            FontSize="13"
                            Padding="14,10"
                            IsEnabled="False"
                            Click="BtnCancelJob_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
