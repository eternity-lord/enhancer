<Window x:Class="Enhancer.Desktop.Retouch.SkinRetouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Enhancer.Desktop.Localization"
        Title="Skin Retouch — Enhancer Studio"
        Width="1380"
        Height="860"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#090D16"
        Foreground="#F8FAFC"
        FlowDirection="{Binding Source={x:Static loc:Strings.Instance}, Path=WindowFlow}"
        Loaded="SkinRetouchWindow_Loaded"
        KeyDown="SkinRetouchWindow_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1322" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#7C2D12" Margin="0,0,12,0">
                        <TextBlock Text="SKIN" FontSize="10" FontWeight="Bold" Foreground="#FED7AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Skin Retouch Workspace / فضای روتوش پوست" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Local, non-destructive, offline retouch — no whole-face reconstruction" FontSize="11.5" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtImageName" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No image" FontSize="12.5" Foreground="#FDBA74" TextTrimming="CharacterEllipsis" Margin="20,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Image" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,7,0" Click="BtnOpenImage_Click" />
                    <Button Content="Before / After" Style="{StaticResource SecondaryStudioButton}" Click="BtnToggleBefore_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242" MinWidth="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="298" MinWidth="270" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0E1525" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="RETOUCH AREA / ناحیه روتوش" FontSize="11.5" FontWeight="Bold" Foreground="#FDBA74" Margin="0,0,0,8" />
                        <TextBlock Text="Paint only on cheeks, forehead or other skin areas. The processor never edits outside the orange mask." TextWrapping="Wrap" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnPaint" Content="Paint" Style="{StaticResource PrimaryStudioButton}" Padding="9,5" Margin="0,0,6,0" Click="BtnPaint_Click" />
                            <Button x:Name="BtnErase" Content="Erase" Style="{StaticResource SecondaryStudioButton}" Padding="9,5" Click="BtnErase_Click" />
                        </StackPanel>

                        <TextBlock Text="Brush size / اندازه قلم" Style="{StaticResource LabLabel}" />
                        <Slider x:Name="SldBrush" Minimum="0.01" Maximum="0.24" Value="0.075" ValueChanged="SettingChanged" />
                        <TextBlock x:Name="TxtBrush" Text="8%" Style="{StaticResource LabValue}" />

                        <TextBlock Text="Retouch strength / شدت روتوش" Style="{StaticResource LabLabel}" Margin="0,12,0,1" />
                        <Slider x:Name="SldStrength" Minimum="0" Maximum="1" Value="0.65" ValueChanged="SettingChanged" />
                        <TextBlock x:Name="TxtStrength" Text="65%" Style="{StaticResource LabValue}" />

                        <TextBlock Text="Texture preservation / حفظ بافت" Style="{StaticResource LabLabel}" Margin="0,12,0,1" />
                        <Slider x:Name="SldTexture" Minimum="0" Maximum="1" Value="0.42" ValueChanged="SettingChanged" />
                        <TextBlock x:Name="TxtTexture" Text="42%" Style="{StaticResource LabValue}" />

                        <CheckBox x:Name="ChkSkinTone" Content="Protect skin tone / حفظ رنگ پوست" IsChecked="True" Margin="0,10,0,12" Checked="SettingChanged" Unchecked="SettingChanged" />
                        <Button Content="Render Retouch / اجرای روتوش" Style="{StaticResource PrimaryStudioButton}" Margin="0,0,0,7" Click="BtnRender_Click" />
                        <Button Content="Clear Mask / پاک‌کردن ماسک" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,0,7" Click="BtnClearMask_Click" />
                        <Button Content="Reset Workspace / بازنشانی" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,0,14" Click="BtnReset_Click" />

                        <Border Background="#111827" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="WHY THIS IS SEPARATE" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,7" />
                                <TextBlock Text="Lab is now for color, curves and protection masks. This workspace has its own explicit mask, renderer and changed-pixel check, so a skin edit cannot be mistaken for a global AI face restore." TextWrapping="Wrap" FontSize="10.5" Foreground="#CBD5E1" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Background="#070A12" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#0C1220" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="13,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Fit" Style="{StaticResource SecondaryStudioButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnFit_Click" />
                            <Button Content="100%" Style="{StaticResource SecondaryStudioButton}" Padding="10,4" Margin="0,0,6,0" Click="Btn100_Click" />
                            <Button Content="200%" Style="{StaticResource SecondaryStudioButton}" Padding="10,4" Click="Btn200_Click" />
                        </StackPanel>
                        <TextBlock x:Name="TxtPreviewMode" Text="EDITED PREVIEW / بعد" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#FDBA74" />
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Margin="18" Background="#0B1020" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#070A12" SizeChanged="PreviewScroll_SizeChanged">
                        <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas x:Name="MaskCanvas" Background="Transparent" IsHitTestVisible="False" Opacity="0.92" Panel.ZIndex="5"
                                    MouseLeftButtonDown="MaskCanvas_MouseLeftButtonDown"
                                    MouseMove="MaskCanvas_MouseMove"
                                    MouseLeftButtonUp="MaskCanvas_MouseLeftButtonUp" />
                        </Grid>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="2" Background="#0C1220" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="13,0">
                    <TextBlock x:Name="TxtResultStatus" VerticalAlignment="Center" Text="Paint an orange area to begin." FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#0E1525" BorderBrush="#1E293B" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="RESULT CHECK / بررسی نتیجه" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8" />
                        <Border Background="#141E30" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtMaskMetrics" Text="Mask: 0 px" FontSize="12" Foreground="#E2E8F0" Margin="0,0,0,7" />
                                <TextBlock x:Name="TxtChangeMetrics" Text="Changed pixels: 0" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,7" />
                                <TextBlock x:Name="TxtDeltaMetrics" Text="Maximum delta: 0" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="WORKFLOW" FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8" />
                        <TextBlock Text="1. Click Paint.&#x0a;2. Paint an orange mask over skin only.&#x0a;3. Click Render Retouch.&#x0a;4. Toggle Before / After to verify the local change.&#x0a;5. Save a copy; the original is never overwritten." TextWrapping="Wrap" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,14" />
                        <Border Background="#1C1917" BorderBrush="#7C2D12" BorderThickness="1" CornerRadius="8" Padding="10">
                            <TextBlock Text="This is simple local retouch, not full AI portrait reconstruction. Keep Texture Preservation above 30% for daily photos." TextWrapping="Wrap" FontSize="10.5" Foreground="#FED7AA" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0D1322" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="100% offline • selected mask only • original remains untouched" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save JPEG" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,8,0" Click="BtnSaveJpeg_Click" />
                    <Button Content="Save PNG" Style="{StaticResource SecondaryStudioButton}" Margin="0,0,8,0" Click="BtnSavePng_Click" />
                    <Button Content="Done" Style="{StaticResource PrimaryStudioButton}" Padding="22,9" Click="BtnDone_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
