    <!-- About / Info Screen -->
    <string name="about_content_desc">درباره Enhancer</string>
    <string name="about_title">درباره Enhancer</string>
    <string name="about_description" formatted="false">برنامه ۱۰۰٪ آفلاین ارتقای کیفیت تصاویر در اندروید با قدرت هوش مصنوعی Real-ESRGAN، موتور ncnn و شتاب‌دهنده Vulkan.</string>
    <string name="about_whats_new_title">قابلیت‌های جدید نسخه ۲.۰</string>
    <string name="about_whats_new_1">نمایشگر بزرگ‌نمایی عمیق با وضوح واقعی فایل خروجی (تا ۴ برابر فراتر از ۱:۱) و مقایسه Bicubic با تصویر اصلی</string>
    <string name="about_whats_new_2">حالت حداکثر کیفیت (Max Quality) با پردازش کامل تصویر، ترکیب ۳۲ پیکسلی کاشی‌ها و Lanczos3</string>
    <string name="about_whats_new_3">حالت اختیاری TTA (x8) و کنترل شارپنس تطبیقی بدون هاله</string>
    <string name="about_whats_new_4">خروجی JPEG با رنگ کامل 4:4:4 (کیفیت ۹۰ تا ۱۰۰، پیش‌فرض ۹۸) و پردازش مجدد سریع با تنظیمات متفاوت</string>
    <string name="about_oss_title">کتابخانه‌های متن‌باز</string>
    <string name="oss_realesrgan">Real-ESRGAN — مجوز BSD 3-Clause</string>
    <string name="oss_ncnn">ncnn — مجوز BSD 3-Clause</string>
