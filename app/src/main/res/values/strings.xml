    <!-- About / Info Screen -->
    <string name="about_content_desc">About Enhancer</string>
    <string name="about_title">About Enhancer</string>
    <string name="about_description" formatted="false">100% offline on-device AI photo enhancement &amp; super-resolution studio for Android powered by Real-ESRGAN, CodeFormer, SCRFD, Light AI, ncnn, and Vulkan GPU compute.</string>
    <string name="about_whats_new_title">What\'s New in 3.0</string>
    <string name="about_whats_new_1">7 Studio AI Modes: Prime, Gentle, Balanced, Strong, Ultra (with Intensity &amp; Size of Changes), Digital Art, and Old Photo</string>
    <string name="about_whats_new_2">Enhance Faces (Photo 2.0): 5-point SCRFD landmark alignment + CodeFormer 512×512 eye, lash &amp; skin restoration with B&amp;W/sepia preservation</string>
    <string name="about_whats_new_3">Light AI (Smart HDR): halo-free Guided Filter shadow recovery, highlight roll-off, adaptive white balance &amp; natural vibrance</string>
    <string name="about_whats_new_4">Anti-gray Vulkan tile integrity verifier, universal multi-ABI APK (arm64-v8a / armeabi-v7a / x86_64, Android 7.0+), and 300 DPI print exports</string>
    <string name="about_oss_title">Open-source credits</string>
    <string name="oss_realesrgan">Real-ESRGAN &amp; LSDIR — BSD 3-Clause License</string>
    <string name="oss_codeformer">CodeFormer &amp; InsightFace SCRFD — S-Lab / MIT License</string>
